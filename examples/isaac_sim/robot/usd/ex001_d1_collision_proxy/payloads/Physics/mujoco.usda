#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "ex001_robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ex001_robot"
{
    over "Physics"
    {
        def MjcActuator "right_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </ex001_robot/Physics/right_wheel_joint>
        }

        def MjcActuator "left_wheel_joint_actuator"
        {
            uniform double mjc:forceRange:max = inf
            uniform double mjc:forceRange:min = -inf
            custom rel mjc:target
            prepend rel mjc:target = </ex001_robot/Physics/left_wheel_joint>
        }

        def MjcActuator "lift_joint_actuator"
        {
            uniform double mjc:forceRange:max = 2000
            uniform double mjc:forceRange:min = -2000
            custom rel mjc:target
            prepend rel mjc:target = </ex001_robot/Physics/lift_joint>
        }

        def MjcActuator "head_yaw_joint_actuator"
        {
            uniform double mjc:forceRange:max = 9
