#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "ex001_robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    subLayers = [
        @./physics.usda@
    ]
    upAxis = "Z"
)

over "ex001_robot"
{
    over "Physics"
    {
        over "right_wheel_joint" (
            prepend apiSchemas = ["PhysxJointAPI"]
        )
        {
        }

