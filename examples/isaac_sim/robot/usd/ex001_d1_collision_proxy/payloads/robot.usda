        </ex001_robot/Physics/right_rear_ultrasonic_joint>,
        </ex001_robot/Physics/tn__2d_laser_link_connector_>,
        </ex001_robot/Physics/tn__3d_laser_link_connector_>,
        </ex001_robot/Physics/base_front_camera_connector>,
