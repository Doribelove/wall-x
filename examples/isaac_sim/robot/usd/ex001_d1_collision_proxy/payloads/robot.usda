        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link/left_arm_link1/left_arm_link2/left_arm_link3/left_arm_link4/left_arm_link5/left_arm_link6/left_arm_gripper_base_link/left_arm_gripper_left_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link/left_arm_link1/left_arm_link2/left_arm_link3/left_arm_link4/left_arm_link5/left_arm_link6/left_arm_gripper_base_link/left_arm_gripper_right_link>,
