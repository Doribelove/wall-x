#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "ex001_robot"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "ex001_robot" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </ex001_robot/Physics/chassis_base_joint>,
        </ex001_robot/Physics/right_wheel_joint>,
        </ex001_robot/Physics/left_wheel_joint>,
        </ex001_robot/Physics/lift_joint>,
        </ex001_robot/Physics/right_tof_joint>,
