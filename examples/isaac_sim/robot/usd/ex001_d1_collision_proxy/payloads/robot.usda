        </ex001_robot/Physics/right_arm_gripper_camera_base_joint>,
        </ex001_robot/Physics/right_arm_gripper_camera_color_frame_joint>,
        </ex001_robot/Physics/chest_lh_camera_color_frame_joint>,
        </ex001_robot/Physics/laser_connector>,
        </ex001_robot/Physics/tn__2d_laser_joint_>,
