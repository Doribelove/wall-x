        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link/left_arm_link1>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link/left_arm_link1/left_arm_link2>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/left_arm_frame_link/left_arm_base_link/left_arm_link1/left_arm_link2/left_arm_link3>,
