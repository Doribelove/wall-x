        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/right_arm_frame_link/right_arm_base_link/right_arm_link1/right_arm_link2/right_arm_link3/right_arm_link4/right_arm_link5/right_arm_link6/right_arm_gripper_base_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/right_arm_frame_link/right_arm_base_link/right_arm_link1/right_arm_link2/right_arm_link3/right_arm_link4/right_arm_link5/right_arm_link6/right_arm_gripper_base_link/right_arm_gripper_motor_link>,
