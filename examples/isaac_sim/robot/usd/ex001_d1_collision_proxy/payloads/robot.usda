                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "camera_head_front_infra1_optical_frame" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }

                                        over "camera_head_front_color_frame" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "camera_head_front_color_optical_frame" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }

                                        over "camera_head_front_depth_frame" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "camera_head_front_depth_optical_frame" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                            }
                                        }

                                        over "camera_head_front_USB_frame" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                        }
                                    }
                                }
                            }
                        }
                    }

                    over "left_arm_frame_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "left_arm_base_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "left_arm_link1" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "left_arm_link2" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "left_arm_link3" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                        over "left_arm_link4" (
                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                        )
                                        {
                                            over "left_arm_link5" (
                                                prepend apiSchemas = ["IsaacLinkAPI"]
                                            )
                                            {
                                                over "left_arm_link6" (
                                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                                )
                                                {
                                                    over "left_arm_gripper_base_link" (
                                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                                    )
                                                    {
                                                        over "left_arm_gripper_motor_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }

                                                        over "left_arm_gripper_left_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }

                                                        over "left_arm_gripper_right_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                        }

                                                        over "left_arm_gripper_camera_base_link" (
                                                            prepend apiSchemas = ["IsaacLinkAPI"]
                                                        )
                                                        {
                                                            over "left_arm_gripper_camera_color_frame" (
                                                                prepend apiSchemas = ["IsaacLinkAPI"]
