        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/right_arm_frame_link/right_arm_base_link/right_arm_link1/right_arm_link2/right_arm_link3>,
        </ex001_robot/Geometry/base_link/chassis_base_link/lift_link/right_arm_frame_link/right_arm_base_link/right_arm_link1/right_arm_link2/right_arm_link3/right_arm_link4>,
