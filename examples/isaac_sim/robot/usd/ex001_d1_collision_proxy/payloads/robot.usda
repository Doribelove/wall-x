        </ex001_robot/Physics/camera_head_front_joint>,
        </ex001_robot/Physics/camera_head_front_right_IR_frame_joint>,
        </ex001_robot/Physics/camera_head_front_left_IR_ROS_frame_joint>,
        </ex001_robot/Physics/camera_head_front_RGB_IR_ROS_frame_joint>,
        </ex001_robot/Physics/camera_head_front_USB_frame_joint>,
        </ex001_robot/Physics/camera_head_front_depth_frame_joint>,
