        </ex001_robot/Physics/left_up_camera_color_frame_joint>,
        </ex001_robot/Physics/right_up_camera_color_frame_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </ex001_robot/Geometry/base_link/chassis_base_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/right_wheel_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/left_wheel_link>,
