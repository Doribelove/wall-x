        </ex001_robot/Geometry/base_link/chassis_base_link/base_front_camera_frame_link/camera_chassis_front_link/camera_chassis_front_bottom_screw_frame/camera_chassis_front_infra2_frame/camera_chassis_front_infra2_optical_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/base_front_camera_frame_link/camera_chassis_front_link/camera_chassis_front_bottom_screw_frame/camera_chassis_front_color_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/base_front_camera_frame_link/camera_chassis_front_link/camera_chassis_front_bottom_screw_frame/camera_chassis_front_color_frame/camera_chassis_front_color_optical_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/base_front_camera_frame_link/camera_chassis_front_link/camera_chassis_front_bottom_screw_frame/camera_chassis_front_depth_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/base_front_camera_frame_link/camera_chassis_front_link/camera_chassis_front_bottom_screw_frame/camera_chassis_front_depth_frame/camera_chassis_front_depth_optical_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/left_up_camera_base_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/left_up_camera_base_link/left_up_camera_color_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/right_up_camera_base_link>,
        </ex001_robot/Geometry/base_link/chassis_base_link/right_up_camera_base_link/right_up_camera_color_frame>,
        </ex001_robot/Geometry/base_link/chassis_base_link/imu_link>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link"
        {
            over "chassis_base_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "right_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "left_wheel_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                }

                over "lift_link" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "head_yaw_link" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "head_pitch_link" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "head_camera_frame_link" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "camera_head_front_bottom_screw_frame" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "camera_head_front_link" (
